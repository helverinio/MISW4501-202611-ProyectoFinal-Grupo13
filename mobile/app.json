{
  "expo": {
    "name": "travel-hub",
    "slug": "travel-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.travelhub.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "travel-hub",
    "plugins": [
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
