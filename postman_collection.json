									"pm.test('Hold acquired successfully', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('hold_id', jsonData.id);",
									"    console.log('Hold ID saved: ' + jsonData.id);",
									"    console.log('Hold expires at: ' + jsonData.expires_at);",
									"}"
								],
								"type": "text/javascript"
							}
						}
