						],
						"url": {
							"raw": "{{gateway_url}}/api/v1/auth/me",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						},
						"description": "Get the current authenticated user's information using the JWT access token"
					},
					"response": []
				},
