						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/api/v1/auth/logout",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Logout and revoke the current access token"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints - Login, Refresh Token, Get User by Token, Logout"
