		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    pm.test('Login successful', function () {",
									"        pm.expect(jsonData.access_token).to.exist;",
									"        pm.expect(jsonData.refresh_token).to.exist;",
									"        pm.expect(jsonData.token_type).to.equal('Bearer');",
									"        pm.expect(jsonData.expires_in).to.equal(3600);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuario\": \"jperez\",\n    \"contrasena\": \"SecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/v1/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticate user and get JWT access token (valid for 1 hour) and refresh token"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    pm.test('Token refreshed successfully', function () {",
									"        pm.expect(jsonData.access_token).to.exist;",
									"        pm.expect(jsonData.refresh_token).to.exist;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/v1/auth/refresh",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Refresh the access token using a valid refresh token. The old tokens are revoked and new ones are issued."
					},
					"response": []
				},
				{
					"name": "Get Current User (By Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.test('User retrieved by token', function () {",
									"        pm.expect(jsonData.id).to.exist;",
									"        pm.expect(jsonData.nombre).to.exist;",
									"        pm.expect(jsonData.email).to.exist;",
									"        pm.expect(jsonData.usuario).to.exist;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
