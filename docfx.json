{
  "metadata": [],
  "build": {
    "content": [
      {
        "src": "docfx",
        "files": [
          "**/*.md",
          "**/toc.yml"
        ],
        "exclude": [
          "accesibility/**"
        ]
      }
    ],
    "resource": [
      {
        "src": "docfx",
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "docs",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "TravelHub Manual de Usuario",
      "_appName": "TravelHub",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
